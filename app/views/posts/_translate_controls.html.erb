<div id="translate-controls" class="d-flex align-items-center" data-translations='<%= (@post_translations || {}).to_json %>'>
  <select id="page-translate-select" class="form-control form-control-sm" data-post-id="<%= @post.id %>" style="width: auto; min-width: 160px;">
    <option value="" disabled selected>Translate page to...</option>
    <% TranslationService::LANGUAGES.each do |code, name| %>
      <option value="<%= code %>"><%= name %></option>
    <% end %>
  </select>
  <span id="saved-translations-hint" class="ml-2 text-success small" style="display:none;" title="Languages with a checkmark already have a translation saved and load instantly for everyone.">
    <i class="fas fa-check-circle"></i> ✓ = saved
  </span>
  <span id="translate-hint" class="ml-2 text-warning small" style="display:none;"><i class="fas fa-info-circle"></i> Please select a language first</span>
  <button id="translate-btn" type="button" class="btn btn-sm btn-outline-primary ml-2" onclick="var s=document.getElementById('page-translate-select'); if(s.value){translateFullPage(s.value)}else{showTranslateHint()}">
    <i class="fas fa-language"></i> Translate
  </button>
  <button id="confirm-btn" type="button" class="btn btn-sm btn-success ml-2" style="display:none;" onclick="confirmTranslation()">
    <i class="fas fa-check"></i> Confirm & Save
  </button>
  <span id="translate-spinner" class="ml-2" style="display:none;"><i class="fas fa-spinner fa-spin"></i> Translating...</span>
  <button id="restore-btn" type="button" class="btn btn-sm btn-outline-danger ml-2" style="display:none;" onclick="restoreOriginalPage()">
    <i class="fas fa-undo"></i> Restore original
  </button>
  <button id="retranslate-btn" type="button" class="btn btn-sm btn-outline-warning ml-2" style="display:none;" onclick="retranslatePage()">
    <i class="fas fa-sync"></i> Retranslate
  </button>
</div>
